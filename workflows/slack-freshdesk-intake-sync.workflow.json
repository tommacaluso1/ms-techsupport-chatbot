    "Freshdesk - Create Ticket": {
      "main": [
        [
          {
            "node": "Postgres - Save Thread Mapping",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - Save Thread Mapping": {
      "main": [
        [
          {
            "node": "Slack - Reply Ticket Created",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook - Freshdesk Ticket Event": {
      "main": [
        [
          {
            "node": "Postgres - Lookup Slack Thread",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - Lookup Slack Thread": {
      "main": [
        [
          {
            "node": "Slack - Reply Ticket Update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
